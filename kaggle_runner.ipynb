EXT3_CONFIGS = [
    "extension3_lstm_dynamic_dunnhumby",
    "extension3_lstm_full_dunnhumby",
    "extension3_transformer_dynamic_dunnhumby",
    "extension3_transformer_full_dunnhumby",
]
subprocess.run([
    sys.executable, "run_seeds.py",
    "--configs", *EXT3_CONFIGS,
    "--seeds", "42", "7", "123",
    "--modes", "sample",
    "--skip_existing",
], check=False)
print("\nExtension 3 (dynamic + full) complete.")
